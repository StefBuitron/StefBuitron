# Copia este archivo a .env y rellena tus datos
STORE_NAME=Mi Tienda
# URL pública donde estará la tienda (TikTok la necesita para leer el catálogo)
BASE_URL=http://localhost:3000
PORT=3000
# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=cambia-esta-clave
# Moneda (la tienda vende en Perú: PEN = soles)
CURRENCY=PEN
# Marca que aparecerá en el catálogo de TikTok
BRAND=Mi Tienda
# Tu usuario de TikTok sin @ (para el enlace del encabezado)
TIKTOK_USERNAME=
# ID del Pixel de TikTok (TikTok Ads Manager > Herramientas > Eventos)
TIKTOK_PIXEL_ID=
# Número de WhatsApp con código de país, solo dígitos (ej. 51987654321)
WHATSAPP_NUMBER=
# Categorías de la tienda, separadas por comas
CATEGORIES=Accesorios,Carteras,Ropa,Vitaminas
